script/source = "extends Node3D

func _ready() -> void:
	Global.weapon_manager.max_weapons_in_inventory = 9
	
	for x in Global.weapon_manager.WEAPON_REGISTRY.size():
		Global.weapon_manager.add_weapon(x)
"

