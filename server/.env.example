ADMIN_USERNAME=change_me
ADMIN_PASSWORD=change_me
ADMIN_PANEL_URL=admin
# Proxy trust: Set to True if server is strictly behind nginx/cloudflare
TRUST_PROXY = false

CLIENT_SECRET=change_me

SESSION_TTL_SECONDS=86400
# Seconds
MAX_REQUEST_AGE = 30

LOGIN_ATTEMPT_LIMIT = 50
BLOCK_TIME_SECONDS  = 180
# Seconds
UPDATE_LEADERBOARD_TIME = 300
REGISTRATION_COOLDOWN   = 60
RECORD_SUBMIT_COOLDOWN  = 60

MAX_WAVE=200
MAX_SCORE=1000000
MAX_LIFETIME=43200
MAX_SCORE_PER_MINUTE=7500
